# CSP Platform Configuration
SECRET_KEY=your-secret-key-change-this-in-production
DATABASE_URL=sqlite:///./data/csp.db

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Account (used by init_db.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Proxy Timeouts (seconds)
EMBEDDING_TIMEOUT=30
LLM_TIMEOUT=120

# Health Check Interval (seconds)
HEALTH_CHECK_INTERVAL=60

# Usage Writer Settings
USAGE_BATCH_SIZE=100
USAGE_FLUSH_INTERVAL=5

# Auto-register models on startup (JSON array)
# AUTO_REGISTER_MODELS=[{"name":"llama3-70b","display_name":"Llama 3 70B","model_type":"llm","endpoint_url":"http://vllm:8000","api_version":"v1"}]

# Auto-register platform links on startup (JSON array)
# AUTO_REGISTER_LINKS=[{"name":"n8n","url":"http://n8n:5678","icon":"workflow","description":"自動化工作流程"}]
