# ============================================================
# CSP Platform 環境變數配置
# 複製此檔為 .env 後修改：cp .env.example .env
# ============================================================

# ---------- 基本設定 ----------
SECRET_KEY=your-secret-key-change-this-in-production
DATABASE_URL=sqlite:///./data/csp.db

# ---------- JWT 設定 ----------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 管理員帳號（首次啟動自動建立）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ---------- Proxy 設定 ----------
EMBEDDING_TIMEOUT=30
LLM_TIMEOUT=120
PROXY_MAX_RETRIES=3

# ---------- 背景任務 ----------
HEALTH_CHECK_INTERVAL=60
USAGE_BATCH_SIZE=100
USAGE_FLUSH_INTERVAL=5

# ---------- Nginx 設定 ----------
# Nginx 對外 port（預設 80）
NGINX_PORT=80
# 使用者瀏覽器存取的基底 URL，用於平台卡片連結
SITE_URL=http://localhost

# ============================================================
# 自動註冊模型（啟動時寫入 DB）
# 格式：JSON 陣列，每筆包含 name, display_name, model_type,
#        endpoint_url, api_version, description 等欄位
# Agent 類型可額外指定 "base_model": "<底層模型 name>"
#
# endpoint_url 說明：
#   - 直連模型：使用內部 Docker 網路位址 (http://vllm-llm:8000)
#   - 透過 nginx：使用 nginx 代理路徑 (http://nginx/models/llama3-70b)
# ============================================================
AUTO_REGISTER_MODELS=[{"name":"llama3-70b","display_name":"Llama 3 70B Instruct","model_type":"llm","endpoint_url":"http://vllm-llm:8000","api_version":"v1","description":"vLLM 部署的 Llama 3 70B 模型","context_window":8192},{"name":"nv-embed-v2","display_name":"NVIDIA NV-Embed V2","model_type":"embedding","endpoint_url":"http://triton-embedding:8000","api_version":"v2","description":"Triton 部署的 NV-Embed-V2 嵌入模型"},{"name":"aia/asrd","display_name":"AIA ASRD Agent","model_type":"agent","endpoint_url":"http://mlsteam-host:45023","api_version":"v1","description":"MLSteam 部署的 ASRD Agent","base_model":"llama3-70b"}]

# ============================================================
# 自動註冊平台連結（儀表板卡片）
# 格式：JSON 陣列，每筆包含 name, url, icon, description
#
# url 說明：
#   - 直連平台：http://n8n:5678
#   - 透過 nginx 代理：${SITE_URL}/n8n
#   - 外部網址：https://mlsteam.ncsist.org.tw
# ============================================================
AUTO_REGISTER_LINKS=[{"name":"n8n 工作流程","url":"http://n8n:5678","icon":"workflow","description":"自動化工作流程平台"},{"name":"GitLab","url":"http://gitlab:8929","icon":"git","description":"程式碼版本控制"},{"name":"MyNotebookLM","url":"http://notebooklm:3000","icon":"notebook","description":"AI 筆記本"},{"name":"MLSteam","url":"https://mlsteam.ncsist.org.tw","icon":"cpu","description":"MLOps 平台 - Agent 開發與部署"}]
